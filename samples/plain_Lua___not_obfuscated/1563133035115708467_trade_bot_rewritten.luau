function bot.decodeArray(body,key)
	local function extract(text)
		local _,start=text:find('"'..key..'"%s*:%s*%[');if not start then return nil end
		local depth,quoted,escaped=0,false,false
		for i=start,#text do
			local c=text:sub(i,i)
			if quoted then if escaped then escaped=false elseif c=="\\" then escaped=true elseif c=='"' then quoted=false end
			elseif c=='"' then quoted=true elseif c=='[' then depth=depth+1 elseif c==']' then depth=depth-1
				if depth==0 then local ok,data=pcall(Http.JSONDecode,Http,text:sub(start,i));return ok and data or nil end
			end
		end
	end
	if type(body)~="string" then return nil end
	local data=extract(body);if data then return data end
	for encoded in body:gmatch('self%.__next_f%.push%(%[%d+,"(.-)"%]%)') do
		local ok,text=pcall(Http.JSONDecode,Http,'"'..encoded..'"');if ok then data=extract(text);if data then return data end end
	end
end
function bot.rawValue(item)
	if type(item)~="table" then return nil end
	local row=bot.byKind[item.kind or item.id];if not row then return nil end
	if row.value~=nil then return tonumber(row.value) end
	local p=item.properties or {};local level=p.mega_neon and 3 or (p.neon and 2 or 1)
	local ride,fly=p.rideable==true,p.flyable==true
	local fields={{"npRegularValue","rValue","fValue","regularValue"},{"npNeonValue","nrValue","nfValue","neonValue"},{"npMegaValue","mrValue","mfValue","megaValue"}}
	local variant=ride and fly and 4 or (ride and 2 or (fly and 3 or 1))
	local value=tonumber(row[fields[level][variant]]);if value then return value end
	local base=tonumber(row[fields[level][4]]);if not base then return nil end
	if variant==4 then return base end
	local r=ratios[tonumber(row.category)];return r and base*r[(level-1)*3+variant] or nil
end
function bot.divisor()
	if bot.unit=="frost" then local row=(bot.prices.pets or {}).frostdragon;return row and tonumber(row.regularValue) end
