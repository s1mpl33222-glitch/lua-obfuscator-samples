				local _,own,partner=checkFlow(flow,generation)
				if next(partner.items) then flow.phase="clear";break end
				if not contains(own.items,item.unique) then addItem(item,true);task.wait(.25) end
			end
			if flow.phase=="show" then flow.phase="shown" end
		end
		if flow.phase=="clear" then
			bot.status("Убираю показанных питомцев перед WIN-подбором...")
			local _,own=checkFlow(flow,generation)
			for _,item in pairs(own.items) do if bot.protected[item.unique] then checkFlow(flow,generation);removeItem(item);task.wait(.15) end end
			local _,final=checkFlow(flow,generation)
			for _,item in pairs(final.items) do assert(not bot.protected[item.unique],"Защищённый питомец ещё в оффере") end
			flow.phase="normal";flow.lastPartner=nil
		end
	end)
end
function bot.fill(flow,theirs)
	local key=bot.signature(theirs.items);local value,missing=bot.total(theirs.items)
	if missing>0 or value<=0 then flow.lastPartner=key;bot.status("Цена предметов партнёра неизвестна — обмен не подтверждаю");return end
	local selected=bot.chooseOffer(bot.inventory(),value,bot.mode)
	flow.lastPartner=key
	if not selected then bot.status("Нет подходящего оффера из незарезервированных предметов");return end
	local generation,mode,unit=bot.generation,bot.mode,bot.unit
	worker(function()
		flow.plan=nil;unaccept(flow,generation,key)
		local wanted={};for _,item in ipairs(selected) do wanted[item.unique]=true end
		local _,mine=checkFlow(flow,generation,key)
		for _,item in pairs(mine.items) do if not wanted[item.unique] then checkFlow(flow,generation,key);removeItem(item);task.wait(.2) end end
		for _,item in ipairs(selected) do local _,current=checkFlow(flow,generation,key);if not contains(current.items,item.unique) then addItem(item,false);task.wait(.25) end end
		local _,final=checkFlow(flow,generation,key)
		assert(bot.mode==mode and bot.unit==unit,"Настройки изменились")
		flow.plan={mine=bot.signature(final.items),partner=key,mode=mode,unit=unit,at=os.clock()};flow.phase="ready"
		bot.status("Оффер подобран. Ожидание игрового отсчёта...")
	end)
end
function bot.extra(flow,mine,theirs)
	local own,missing=bot.total(mine.items);local other,missingOther=bot.total(theirs.items)
	flow.addRequested=false
	if missing+missingOther>0 then bot.status("Не могу добавить без полной оценки оффера");return end
	local item=bot.chooseExtra(bot.inventory(),mine.items,own,other)
	if not item then bot.status("Добавить без потери выгоды нечего");return end
	local key,generation,unit,mode=bot.signature(theirs.items),bot.generation,bot.unit,bot.mode
	worker(function()
		flow.plan=nil;unaccept(flow,generation,key)
		local _,current,partner=checkFlow(flow,generation,key)
		local a,x=bot.total(current.items);local b,y=bot.total(partner.items);local v=bot.value(item)
		assert(x+y==0 and v and v>0 and a+v<b-1e-10,"Добавление уберёт выгоду")
		addItem(item,false);task.wait(.25)
		local _,final=checkFlow(flow,generation,key)
		flow.plan={mine=bot.signature(final.items),partner=key,mode=mode,unit=unit,at=os.clock()}
		bot.status("Добавлен предмет. Выгода сохранена.")
	end)
end
function bot.tradeDecision(flow,state,mine,theirs,now,locked)
	if not bot.config.auto then return nil end
	if not next(theirs.items or {}) then
		flow.emptySince=flow.emptySince or now
		if now-flow.emptySince>=10 then return "decline" end
		return nil
	end
	flow.emptySince=nil
	local unsafe=count(mine.items)>bot.maxItems
	for _,item in pairs(mine.items) do if bot.protected[item.unique] then unsafe=true end end
	if unsafe and state.current_stage=="confirmation" then return "unsafe" end
	if unsafe or bot.busy or flow.addRequested or flow.phase~="ready" or locked or state.processing then return nil end
	local plan=flow.plan
	if not plan or plan.mine~=bot.signature(mine.items) or plan.partner~=bot.signature(theirs.items) or plan.mode~=bot.mode or plan.unit~=bot.unit or now-plan.at<1 then return nil end
	if not next(mine.items) then return nil end
	for _,item in pairs(mine.items) do local v=bot.value(item);if not v or v<=0 then return nil end end
	local own,a=bot.total(mine.items);local other,b=bot.total(theirs.items)
	if a+b>0 or not bot.inRange(own,other,bot.mode) then return nil end
	if state.current_stage=="negotiation" and not mine.negotiated then return "accept" end
	if state.current_stage=="confirmation" and mine.negotiated and theirs.negotiated and not mine.confirmed then return "confirm" end
end
function bot.act(action,flow)
	if os.clock()-(bot.lastAction or -math.huge)<1 then return end;bot.lastAction=os.clock()
	if action=="decline" or action=="unsafe" then
		bot.generation=bot.generation+1;native(function() bot.context.trade:_decline_trade() end)
		bot.status(action=="unsafe" and "Отмена: защищённые предметы/превышен лимит" or "Отмена: партнёр ничего не добавил за 10 сек.");return
	end
	native(function()
		local state,mine,theirs=bot.state();assert(state and state.trade_id==flow.id,"Трейд закрыт")
		assert(bot.tradeDecision(flow,state,mine,theirs,os.clock(),bot.context.trade.lock_countdown:is_going())==action,"Оффер изменился перед подтверждением")
		if action=="accept" then bot.context.trade:_on_accept_pressed();bot.status("Оффер принят. Ожидание партнёра...")
		elseif action=="confirm" then bot.remember(state,mine,theirs);bot.context.trade:_on_confirm_pressed();bot.status("Подтверждение отправлено. Проверяю результат на сервере...") end
	end)
end
function bot.isAddRequest(text)
	if type(text)~="string" then return false end
	local chars={};text=(text:gsub("<[^>]+>",""))
	for _,c in utf8.codes(text) do if c>=1040 and c<=1071 then c=c+32 elseif c==1025 then c=1105 end;chars[#chars+1]=utf8.char(c) end
	text=table.concat(chars):lower():gsub("’","'")
	for _,negative in ipairs({"don't add","dont add","not add","no add","i will add","i'll add","let me add","не добав","не надо","я добав","могу добав"}) do if text:find(negative,1,true) then return false end end
	if text:find("%f[%a]add%f[%A]") then return true end
	for _,s in ipairs({"добавь","добавить","добавишь","докинь"}) do if text:find(s,1,true) then return true end end
	text=text:gsub("[%s!?%.]","");return text=="ещё" or text=="еще"
end
function bot.message(senderId,text)
	if not bot.ready or not bot.config.auto or not bot.isAddRequest(text) then return false end
	local state=bot.state();local flow=bot.flow
	if not state or not flow or state.trade_id~=flow.id or state.current_stage~="negotiation" then return false end
	local partner=state.sender==player and state.recipient or state.sender
	if not partner or partner.UserId~=senderId or os.clock()-(flow.lastAsk or -math.huge)<2 then return false end
	flow.lastAsk=os.clock();flow.addRequested=true;return true
end
