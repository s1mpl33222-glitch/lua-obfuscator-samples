-- Trade Bot V2. Standalone rewrite; no dependency on trade_values.luau.
-- Settings and teleport bootstrap live in the executor's workspace.
local VERSION = "2.0.0"
local ROOT_PLACE = 920587237
local SETTINGS_FILE = "trade_bot_v2_settings.json"
local BOOTSTRAP_FILE = "trade_bot_v2_autoload.luau"
local ENV = getgenv()
for _, old in ipairs({ ENV.TradeBotV2 or false, ENV.TradeValueEngine or false }) do
	if type(old) == "table" and type(old.stop) == "function" then pcall(old.stop) end
end
ENV.TradeValueEngine = nil
local Players = game:GetService("Players")
repeat task.wait() until Players.LocalPlayer
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Http = game:GetService("HttpService")
local Input = game:GetService("UserInputService")
local Tween = game:GetService("TweenService")
local Teleport = game:GetService("TeleportService")
for _, name in ipairs({"RockTradeBotV2", "AutoFillGui", "TradeValueGui", "TradeAutomationSettings", "TradeImageOverlay"}) do
	local old = playerGui:FindFirstChild(name)
	while old do old:Destroy(); old = playerGui:FindFirstChild(name) end
end
local bot = {
	version = VERSION, running = true, phase = "waiting", ready = false, busy = false,
	connections = {}, labels = setmetatable({}, { __mode = "k" }),
	prices = {}, byKind = {}, protected = {}, sent = {}, visited = {}, proofs = {}, verifying = {},
	unit = "baseless", mode = "win", generation = 0, maxItems = 6,
	config = { auto = true, antiAfk = true, hop = false, minutes = 15, minPlayers = 8, webhook = "" },
}
ENV.TradeBotV2 = bot
do
	local ok, data = pcall(function() return Http:JSONDecode(readfile(SETTINGS_FILE)) end)
	if ok and type(data) == "table" then
		for _, key in ipairs({"auto", "antiAfk", "hop"}) do if type(data[key]) == "boolean" then bot.config[key] = data[key] end end
		bot.config.minutes = math.clamp(tonumber(data.minutes) or 15, 1, 240)
		bot.config.minPlayers = math.clamp(math.floor(tonumber(data.minPlayers) or 8), 1, 100)
		if type(data.webhook) == "string" then bot.config.webhook = data.webhook end
		if type(data.sent) == "table" then bot.sent = data.sent end
		if type(data.visited) == "table" then bot.visited = data.visited end
	end
end
if ENV.TradeBotV2Resume ~= nil then bot.config.auto = ENV.TradeBotV2Resume == true; ENV.TradeBotV2Resume = nil end
local function connect(signal, fn)
	local c = signal:Connect(fn); bot.connections[#bot.connections + 1] = c; return c
end
local function gameCall(fn)
	local identity = type(getthreadidentity) == "function" and getthreadidentity()
	if identity and type(setthreadidentity) == "function" then setthreadidentity(2) end
	local result = table.pack(pcall(fn))
	if identity and type(setthreadidentity) == "function" then setthreadidentity(identity) end
	return table.unpack(result, 1, result.n)
end
local function native(fn)
	local result = table.pack(gameCall(fn))
	if not result[1] then error(tostring(result[2]), 2) end
	return table.unpack(result, 2, result.n)
end
function bot.save()
	for id,timestamp in pairs(bot.sent) do if type(timestamp)~="number" or os.time()-timestamp>604800 then bot.sent[id]=nil end end
	for id,timestamp in pairs(bot.visited) do if type(timestamp)~="number" or os.time()-timestamp>21600 then bot.visited[id]=nil end end
	local data = table.clone(bot.config); data.sent = bot.sent; data.visited = bot.visited
	return pcall(function() writefile(SETTINGS_FILE, Http:JSONEncode(data)) end)
end
function bot.net(options)
	local fn = request or http_request
