-- Only server history with an exact trade ID is considered successful.
function bot.validWebhook(url)
	if type(url)~="string" or #url>2000 then return false end
	local host,path=url:match("^https://([^/]+)(/.*)$")
	if not ({["discord.com"]=true,["discordapp.com"]=true,["canary.discord.com"]=true,["ptb.discord.com"]=true})[host] then return false end
	path=(path:match("^[^?]+") or path):gsub("^/api/v%d+/","/api/")
	return path:match("^/api/webhooks/%d+/[%w_%-]+$")~=nil
end
function bot.sendWebhook(embed,url)
	url=url or bot.config.webhook;if not bot.validWebhook(url) then return false,"Укажи Discord-вебхук" end
	bot.webhookCode=nil
	local response=bot.net({Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=Http:JSONEncode({username="Trade Bot V2",allowed_mentions={parse={}},embeds={embed}})})
	if not response then return false,"Ошибка сети" end
	bot.webhookCode=tonumber(response.StatusCode) or 0
	return bot.webhookCode>=200 and bot.webhookCode<300,"HTTP "..bot.webhookCode
end
function bot.testWebhook() return bot.sendWebhook({title="Тест Trade Bot V2",description="Вебхук подключён.",color=3066993}) end
function bot.historyMatch(history,id,userId)
	for _,record in pairs(type(history)=="table" and history or {}) do if type(record)=="table" and record.trade_id==id and (record.sender_user_id==userId or record.recipient_user_id==userId) then return record end end
end
function bot.remember(state,mine,theirs)
	local a,x=bot.total(mine.items);local b,y=bot.total(theirs.items)
	bot.proofs[state.trade_id]={id=state.trade_id,own=a,other=b,known=x+y==0,unit=bot.unit}
end
local function describe(items)
	local lines={}
	for _,item in pairs(items or {}) do
		local d=(bot.context.db[item.category] or {})[item.kind or item.id] or {};local p=item.properties or {};local tags=""
		if p.mega_neon then tags="M" elseif p.neon then tags="N" end;if p.flyable then tags=tags.."F" end;if p.rideable then tags=tags.."R" end
		local line=tostring(d.name or item.kind or item.id)..(tags~="" and (" ["..tags.."]") or "")
		if #table.concat(lines,"\n")+#line<950 then lines[#lines+1]=line end
	end
	return #lines>0 and table.concat(lines,"\n") or "—"
end
function bot.verify(id)
	local proof=bot.proofs[id];if not proof or bot.sent[id] or bot.verifying[id] then return end
	if not bot.validWebhook(bot.config.webhook) then bot.proofs[id]=nil;return end
	bot.verifying[id]=true
	task.spawn(function()
		local record
		for _,delay in ipairs({1,3,7}) do
			task.wait(delay);if not bot.running then return end
			local ok,history=gameCall(function() return route("TradeAPI/GetTradeHistory"):InvokeServer() end)
			if ok then record=bot.historyMatch(history,id,player.UserId) end;if record then break end
		end
		if record then
			local sender=record.sender_user_id==player.UserId
			local fields={{name="Игрок",value=player.Name,inline=true},{name="Партнёр",value=tostring(sender and record.recipient_name or record.sender_name),inline=true},
				{name="Отдано",value=describe(sender and record.sender_items or record.recipient_items)},
				{name="Получено",value=describe(sender and record.recipient_items or record.sender_items)}}
			if proof.known then fields[#fields+1]={name="Оценка ("..proof.unit..")",value="Отдано: "..format(proof.own).."\nПолучено: "..format(proof.other).."\nРазница: "..format(proof.other-proof.own)} end
			for attempt=1,3 do
				if not bot.running then return end
				local ok=bot.sendWebhook({title="Успешный трейд",color=3066993,fields=fields,footer={text="Trade ID: "..id}})
				if ok then bot.sent[id]=os.time();bot.save();break end
				if bot.webhookCode and bot.webhookCode>=400 and bot.webhookCode<500 and bot.webhookCode~=429 then break end
				if attempt<3 then task.wait(attempt*3) end
			end
		end
		bot.verifying[id],bot.proofs[id]=nil,nil
	end)
end
function bot.chooseServer(list,current,visited,minimum,now)
	local good,fallback={},{}
	for _,s in ipairs(list or {}) do if type(s)=="table" and type(s.id)=="string" and s.id~=current and type(s.playing)=="number" and type(s.maxPlayers)=="number"
		and s.playing>0 and s.playing<s.maxPlayers and (not visited[s.id] or now-visited[s.id]>21600) then fallback[#fallback+1]=s;if s.playing>=minimum then good[#good+1]=s end end end
	local pool=#good>0 and good or fallback;table.sort(pool,function(a,b) if a.playing~=b.playing then return a.playing>b.playing end;return (tonumber(a.ping) or math.huge)<(tonumber(b.ping) or math.huge) end)
	return pool[1]
end
function bot.queueResume()
	if bot.queued then return true end
	if type(ENV.TradeBotV2Source)=="string" then pcall(writefile,BOOTSTRAP_FILE,ENV.TradeBotV2Source) end
	local ok,source=pcall(readfile,BOOTSTRAP_FILE)
	if not ok or type(source)~="string" or not source:find('local VERSION = "'..VERSION..'"',1,true) then return false end
	local queue=queue_on_teleport or queueonteleport;if type(queue)~="function" then return false end
	local code=[[repeat task.wait(.5) until game:IsLoaded() and game:GetService("Players").LocalPlayer
local ok,source=pcall(readfile,"trade_bot_v2_autoload.luau")
if ok and type(source)=="string" then getgenv().TradeBotV2Source=source;getgenv().TradeBotV2Resume=__AUTO__;local f=loadstring(source);if f then f() end end]]
	code=code:gsub("__AUTO__",tostring(bot.config.auto));bot.queued=pcall(queue,code);return bot.queued
end
function bot.hop(manual)
	if bot.hopping or (not manual and not bot.config.hop) then return false end
	if bot.state() or bot.busy or next(bot.verifying) then bot.settingsStatus("Переход отложен до завершения трейда");return false end
	if os.clock()-(bot.lastHop or -math.huge)<15 then return false end
	bot.hopping=true;bot.lastHop=os.clock();bot.settingsStatus("Ищу доступный заполненный сервер...")
	task.spawn(function()
		local list,cursor={},nil
		for _=1,3 do
			local url="https://games.roblox.com/v1/games/"..ROOT_PLACE.."/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
			if cursor then url=url.."&cursor="..Http:UrlEncode(cursor) end
			local response=bot.net({Url=url,Method="GET"});if not response or response.StatusCode~=200 then break end
			local ok,data=pcall(Http.JSONDecode,Http,response.Body);if not ok or type(data)~="table" then break end
			for _,s in ipairs(data.data or {}) do list[#list+1]=s end;cursor=data.nextPageCursor;if not cursor or #list>=200 then break end
		end
		if not bot.running then return end
		local server=bot.chooseServer(list,game.JobId,bot.visited,bot.config.minPlayers,os.time())
		if not server then bot.hopping=false;bot.nextHop=os.clock()+30;bot.settingsStatus("Нет подходящего сервера. Повтор через 30 сек.");return end
		if bot.state() or bot.busy or next(bot.verifying) then bot.hopping=false;return end
		if not bot.queueResume() then bot.hopping=false;bot.nextHop=os.clock()+60;bot.settingsStatus("Не найден bootstrap/queue_on_teleport. Сначала запусти сохранённую версию V2.");return end
		bot.visited[game.JobId],bot.visited[server.id]=os.time(),os.time();bot.save()
		bot.settingsStatus("Переход: "..server.playing.."/"..server.maxPlayers.." игроков")
		local ok=gameCall(function() Teleport:TeleportToPlaceInstance(ROOT_PLACE,server.id,player) end)
		if not ok then bot.hopping=false;bot.nextHop=os.clock()+30;bot.settingsStatus("Телепортация не удалась") end
	end)
	return true
end
connect(Teleport.TeleportInitFailed,function(p) if p==player then bot.hopping=false;bot.nextHop=os.clock()+30;bot.settingsStatus("Ошибка перехода. Повтор через 30 сек.") end end)
function bot.keepAlive()
	if not bot.running or not bot.config.antiAfk then return false end
	local identity=type(getthreadidentity)=="function" and getthreadidentity()
	if identity and type(setthreadidentity)=="function" then setthreadidentity(8) end
	local ok,err=pcall(function() local v=game:GetService("VirtualUser");v:CaptureController();v:ClickButton2(Vector2.new(0,0)) end)
	if identity and type(setthreadidentity)=="function" then setthreadidentity(identity) end
	bot.lastAntiAfkError=not ok and tostring(err) or nil
	return ok
end
connect(player.Idled,bot.keepAlive)

local function wireChat()
	connect(game:GetService("TextChatService").MessageReceived,function(m) if m.TextSource then bot.message(m.TextSource.UserId,m.Text) end end)
	local quick=route("TradeAPI/QuickChatReceived")
	connect(quick.OnClientEvent,function(sender,text)
		if typeof(sender)=="Instance" and sender:IsA("Player") then bot.message(sender.UserId,text);return end
		local state=bot.state();if not state then return end;local partner=state.sender==player and state.recipient or state.sender
		if partner then bot.message(partner.UserId,type(sender)=="string" and sender or text) end
	end)
	local content=bot.context.trade.chat_scrolling_frame:FindFirstChild("Content")
	if content then connect(content.ChildAdded,function(l)
		if not l:IsA("TextLabel") then return end
		local function read()
			local name,text=l.Text:match("^<b>(.-)</b>:%s*(.*)$");if not name then return end
			local state=bot.state();if not state then return end;local partner=state.sender==player and state.recipient or state.sender
			if partner and (name:lower()==partner.Name:lower() or name:lower()==partner.DisplayName:lower()) then bot.message(partner.UserId,text) end
		end
		connect(l:GetPropertyChangedSignal("Text"),read);task.defer(read)
	end) end
end
local function loadPrices()
	for i,category in ipairs({"pets","eggs","food","petwear","strollers","vehicles","toys","gifts","stickers"}) do
		if not bot.running then return false end;bot.status("Загрузка цен: "..i.."/9 — "..category)
		local response=bot.net({Url="https://amvgg.com/values/"..category,Method="GET"})
		local rows=response and bot.decodeArray(response.Body,category=="pets" and "pets" or "items")
		local index={};for _,row in ipairs(rows or {}) do if type(row.name)=="string" then index[normalize(row.name)]=row end end;bot.prices[category]=index
	end
	local n=0;local aliases={pet_accessories="petwear",transport="vehicles"}
	for category,kinds in pairs(bot.context.db) do if type(kinds)=="table" then
		for kind,definition in pairs(kinds) do if type(definition)=="table" and type(definition.name)=="string" then
			local key=normalize(definition.name);local row=(bot.prices[aliases[category] or category] or {})[key]
			if category=="pets" then row=row or (bot.prices.eggs or {})[key] end
			if row then bot.byKind[kind]=row;n=n+1 end
		end end
	end end
	bot.mapped=n;return n>0 and next(bot.prices.pets or {})~=nil
end
local function boot()
	bot.status("Ожидание TradeApp и BackpackApp. Во время загрузки Fsys не вызывается.")
	while bot.running do
		local tradeGui,backpackGui=playerGui:FindFirstChild("TradeApp"),playerGui:FindFirstChild("BackpackApp")
		if tradeGui and tradeGui:FindFirstChild("Frame") and backpackGui and backpackGui:FindFirstChild("Frame") then break end
		task.wait(1)
	end
	if not bot.running then return end
	local ok,context=gameCall(function()
		local fs=require(game:GetService("ReplicatedStorage"):WaitForChild("Fsys"))
		local ui=fs.load("UIManager");return {ui=ui,db=fs.load("InventoryDB"),client=fs.load("ClientData"),trade=ui.apps.TradeApp}
	end)
	if not ok or not context.trade or not context.trade.lock_countdown then
		bot.phase="error";bot.lastError=tostring(context);bot.status("Игра не готова: модуль Fsys завершился ошибкой. Используй переход на сервер в настройках.");return
	end
	bot.context=context;bot.phase="prices";wireChat()
	if not loadPrices() then bot.phase="error";bot.status("Не удалось загрузить цены. Автообмен не запущен.");return end
	bot.reserve();bot.ready=true;bot.phase="running";bot.status("V"..VERSION..": готово. Цен сопоставлено: "..bot.mapped)
	gameCall(function() local bp=context.ui.apps.BackpackApp;if bp.render_thread and coroutine.status(bp.render_thread)=="dead" then bp.render_queued=false end;bp:refresh_rendered_items() end)
	task.spawn(function()
		local response=bot.net({Url="https://raw.githubusercontent.com/rockscripter/123/main/xd.png",Method="GET"})
		if response and response.StatusCode==200 and type(response.Body)=="string" and response.Body:sub(1,8)=="\137PNG\r\n\26\n" then
			local success,asset=pcall(function() writefile("trade_bot_v2_image.png",response.Body);return getcustomasset("trade_bot_v2_image.png") end)
			if success and bot.running then picture.Image=asset end
		end
	end)
	print("[TradeBotV2] READY",VERSION,"mapped",bot.mapped)
end
function bot.tick()
	if not bot.context then return end
	local state,mine,theirs=bot.state()
	if bot.flow and (not state or state.trade_id~=bot.flow.id) then bot.verify(bot.flow.id);bot.generation=bot.generation+1;bot.flow=nil end
	bot.meter(state,mine,theirs)
	if state and (state.current_stage=="confirmation" or state.processing) then bot.remember(state,mine,theirs) end
	if not state then
		if not bot.ready or not bot.config.auto or bot.busy or bot.hopping or os.clock()<(bot.nextRequest or 0) then return end
		if not bot.requests or bot.requestIndex>#bot.requests then
			bot.requests={};for _,p in ipairs(Players:GetPlayers()) do if p~=player then bot.requests[#bot.requests+1]=p end end
			table.sort(bot.requests,function(a,b) return a.UserId<b.UserId end);bot.requestIndex=1
		end
		local target=bot.requests[bot.requestIndex];bot.requestIndex=bot.requestIndex+1
		if target and target.Parent==Players then native(function() route("TradeAPI/SendTradeRequest"):FireServer(target) end);bot.status("Запрос отправлен: "..target.Name) end
		bot.nextRequest=os.clock()+(bot.requestIndex>#bot.requests and 15 or .75);return
	end
	if not bot.flow then
		bot.mode="win";bot.flow={id=state.trade_id,phase="prepare",started=os.clock()};bot.generation=bot.generation+1
	end
	local flow=bot.flow
	if not bot.config.auto then return end
	local locked=bot.context.trade.lock_countdown:is_going()
	local action=bot.tradeDecision(flow,state,mine,theirs,os.clock(),locked)
	if action then bot.act(action,flow);return end
	if not next(theirs.items) then bot.status("Ожидание предметов партнёра: "..math.max(0,math.ceil(10-(os.clock()-(flow.emptySince or os.clock())))).." сек.") end
	if not bot.ready or bot.busy or state.current_stage~="negotiation" then return end
	if flow.phase=="prepare" or flow.phase=="show" or flow.phase=="shown" or flow.phase=="clear" then bot.prepare(flow,mine,theirs);return end
	local key=bot.signature(theirs.items)
	if key~=flow.observedPartner then flow.observedPartner=key;flow.changedAt=os.clock();flow.plan=nil end
	if key=="" or os.clock()-(flow.changedAt or os.clock())<1 then return end
	if flow.lastPartner~=key or not flow.plan then
		if flow.lastPartner==key and not flow.plan and os.clock()-(flow.lastAttempt or 0)<5 then return end
		flow.lastAttempt=os.clock();bot.fill(flow,theirs);return
	end
	if flow.addRequested then bot.extra(flow,mine,theirs) end
end
bot.nextHop=os.clock()+bot.config.minutes*60
function bot.stop()
	if not bot.running then return end;bot.running=false;bot.generation=bot.generation+1
	for _,c in ipairs(bot.connections) do c:Disconnect() end
	for _,t in ipairs(bot.barTweens or {}) do t:Cancel() end
	for l in pairs(bot.labels) do l:Destroy() end
	gui:Destroy()
end
if type(ENV.TradeBotV2Source)=="string" then pcall(writefile,BOOTSTRAP_FILE,ENV.TradeBotV2Source) end
task.spawn(function() local ok,err=xpcall(boot,debug.traceback);if not ok then bot.phase="error";bot.lastError=err;bot.status("Ошибка запуска: "..tostring(err):match("^[^\n]+"));warn("[TradeBotV2]",err) end end)
task.spawn(function()
	while bot.running do
		local ok,err=xpcall(bot.tick,debug.traceback)
		if not ok then bot.lastError=tostring(err);bot.status("Ошибка: "..tostring(err):match("^[^\n]+"));warn("[TradeBotV2]",err) end
		if bot.context and bot.ready and os.clock()-(bot.lastCards or 0)>.7 then bot.lastCards=os.clock();pcall(bot.cards) end
		if bot.config.hop then timerLabel.Text="Смена сервера через "..math.max(0,math.ceil(bot.nextHop-os.clock())).." сек.";if os.clock()>=bot.nextHop then bot.hop(false) end else timerLabel.Text="Trade Bot V"..VERSION.." • "..bot.phase end
		task.wait(.25)
	end
end)
print("[TradeBotV2] BOOT",VERSION,"waiting for native game UI")
return bot
